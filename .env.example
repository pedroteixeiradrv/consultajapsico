# ConsultaJáPsico — variáveis de ambiente (sem segredos reais)
# Copie para .env.local e preencha quando integrar.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ConsultaJáPsico

# Session cookie (jose HS256) — use um valor longo em produção
SESSION_SECRET=consultaja-local-demo-secret-change-me-in-prod

# Supabase (opcional — sem URL+SERVICE_ROLE o app usa data/store.json)
# Store backend requires NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# ANON_KEY is for optional browser client only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LivePix OAuth (sem CLIENT_ID+SECRET → stub checkout + /api/payments/stub-confirm)
# Prefer CONSULTAJA-specific vars; fallback to shared LIVEPIX_CLIENT_ID / LIVEPIX_CLIENT_SECRET
LIVEPIX_CLIENT_ID_CONSULTAJA=
LIVEPIX_CLIENT_SECRET_CONSULTAJA=
LIVEPIX_CLIENT_ID=
LIVEPIX_CLIENT_SECRET=
# Opcional — alguns setups usam API key adicional / alias de client id
LIVEPIX_API_KEY=
LIVEPIX_WEBHOOK_SECRET=
# LIVEPIX_OAUTH_SCOPE=payments:write payments:read account:read
# Webhook: POST /api/payments/livepix/webhook


# DEMO=1 forces stub checkout/confirm even outside development (never in real prod)
# DEMO=0
# Stub payments also allowed when NODE_ENV=development

# WhatsApp: professionals must register a valid BR/E.164 number; call room uses wa.me deep link (LiveKit removed)

# Resend — real e-mail when both set; otherwise log-only
# RESEND_API_KEY=
# EMAIL_FROM=noreply@consultaja.local

# LivePix — required in production for consultation + subscription payments
# LIVEPIX_CLIENT_ID_CONSULTAJA=
# LIVEPIX_CLIENT_SECRET_CONSULTAJA=
# LIVEPIX_WEBHOOK_SECRET=
# Webhook: POST /api/payments/livepix/webhook
# Subscription reference format: sub:<psychologistId>:<ts> → sets active + expires_at=+30d

# Payouts: NO automatic LivePix transfer. Admin marks batches paid on days 10 and 28.

# LiveKit (unused — call room uses WhatsApp wa.me)
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Resend (stub — e-mail; fila NÃO é e-mail-only)
# Sem mensalidade active → blast de nova solicitação NÃO é logado
RESEND_API_KEY=
EMAIL_FROM=noreply@consultaja.local
